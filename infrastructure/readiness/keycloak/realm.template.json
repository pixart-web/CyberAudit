{
  "realm": "cyberaudit-readiness",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      {"name": "CyberAudit-Viewer"},
      {"name": "CyberAudit-Analyst"},
      {"name": "CyberAudit-Admin"}
    ]
  },
  "clients": [
    {
      "clientId": "cyberaudit-web",
      "name": "CyberAudit readiness browser client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["https://cyberaudit.localhost:18443/*"],
      "webOrigins": ["https://cyberaudit.localhost:18443"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://cyberaudit.localhost:18443/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {"full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "claim.name": "groups"}
        }
      ]
    }
  ],
  "groups": [
    {"name": "CyberAudit-Viewer", "realmRoles": ["CyberAudit-Viewer"]},
    {"name": "CyberAudit-Analyst", "realmRoles": ["CyberAudit-Analyst"]},
    {"name": "CyberAudit-Admin", "realmRoles": ["CyberAudit-Admin"]}
  ],
  "users": [
    {"username": "viewer@example.test", "email": "viewer@example.test", "enabled": true, "emailVerified": true, "groups": ["CyberAudit-Viewer"], "credentials": [{"type": "password", "value": "__VIEWER_PASSWORD__", "temporary": false}]},
    {"username": "analyst@example.test", "email": "analyst@example.test", "enabled": true, "emailVerified": true, "groups": ["CyberAudit-Analyst"], "credentials": [{"type": "password", "value": "__ANALYST_PASSWORD__", "temporary": false}]},
    {"username": "admin@example.test", "email": "admin@example.test", "enabled": true, "emailVerified": true, "groups": ["CyberAudit-Admin"], "credentials": [{"type": "password", "value": "__ADMIN_PASSWORD__", "temporary": false}]}
  ]
}
