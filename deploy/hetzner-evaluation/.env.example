# Copy to .env (chmod 600). NEVER commit the real file.
CANONICAL_HOST=cyberaudit.pixart.pt
ALIAS_HOST=www.cyberaudit.pixart.pt
TRAEFIK_NETWORK=traefik            # name of the existing Nodera/Traefik docker network
TRAEFIK_CERT_RESOLVER=letsencrypt  # name of the existing certresolver

# Images (built by deploy.sh from a specific git SHA, tagged cyberaudit-{api,web}:<sha>)
CYBERAUDIT_API_IMAGE=cyberaudit-api:local
CYBERAUDIT_WEB_IMAGE=cyberaudit-web:local

# Generate each with:  openssl rand -base64 36 | tr -d '\n'
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# One-time first-run secret (>=16 chars). Set it, open /setup, create the administrator,
# then REMOVE it from this file and redeploy. Empty = bootstrap disabled.
BOOTSTRAP_TOKEN=

AI_RUNTIME_BACKEND=disabled        # or "ollama" once a local model is installed

# Vendor license public key(s), JSON array, from `scripts/licensing/issue_license.py keygen`.
# Empty = license import disabled (Community edition only). Never put a private key here.
LICENSE_TRUSTED_PUBLIC_KEYS=[]
