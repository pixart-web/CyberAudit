{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberAudit OS",
  "version": "0.1.0",
  "identifier": "com.pixart.cyberaudit",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @cyberaudit/web dev --hostname 127.0.0.1 --port 3000",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "CyberAudit OS",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
