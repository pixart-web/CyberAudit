ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cyberaudit:cyberaudit@postgres:5432/cyberaudit
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-an-independent-32-character-key
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
APP_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
REQUIRE_HTTPS=false
SECURE_COOKIES=false
AUTHENTICATION_MODE=local
LOCAL_AUTH_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_REFERENCE=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_DOMAINS=[]
OIDC_REQUIRED_GROUP=
OIDC_MAX_GROUPS=100
OIDC_REQUIRE_VERIFIED_EMAIL=true
MFA_REQUIRED=false
WEBAUTHN_ENABLED=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CyberAudit
WEBAUTHN_ORIGINS=["http://localhost:3000"]
RLS_REQUIRED=false
DATABASE_RUNTIME_ROLE=
SECRET_PROVIDER=environment
VAULT_ADDRESS=
VAULT_NAMESPACE=
VAULT_TOKEN_FILE=/var/run/secrets/vault/token
OBJECT_STORAGE_PROVIDER=filesystem
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=eu-west-1
CONNECTOR_MODE=fixture
RUNNER_TYPE=local_restricted
RUNNER_CONTROLLER_URL=
RUNNER_TOKEN_FILE=/var/run/secrets/cyberaudit/runner-token
TELEMETRY_ENABLED=false
# Sovereign AI runtime: "disabled" (default, fully offline) or "ollama" for a
# self-hosted, local-only Ollama server under your own control.
AI_RUNTIME_BACKEND=disabled
AI_RUNTIME_BASE_URL=http://127.0.0.1:11434
AI_RUNTIME_TIMEOUT_SECONDS=30
# Optional local embedding model name (e.g. nomic-embed-text) served by the
# same Ollama backend above. Leave empty to use deterministic lexical
# retrieval instead of embeddings.
AI_RUNTIME_EMBEDDING_MODEL=
# PEM-encoded Ed25519 public keys trusted to sign offline update bundles
# (.caup), as a JSON array of strings. Leave empty to reject every bundle --
# a bundle is never trusted merely because it was uploaded.
UPDATE_TRUSTED_PUBLIC_KEYS_PEM=[]
