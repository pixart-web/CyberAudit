ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://cyberaudit:cyberaudit@postgres:5432/cyberaudit
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-an-independent-32-character-key
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
APP_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
REQUIRE_HTTPS=false
SECURE_COOKIES=false
AUTHENTICATION_MODE=local
LOCAL_AUTH_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
SECRET_PROVIDER=environment
OBJECT_STORAGE_PROVIDER=filesystem
CONNECTOR_MODE=fixture
RUNNER_TYPE=local_restricted
TELEMETRY_ENABLED=false
